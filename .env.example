# Plateau State Revenue Platform — environment configuration
#
# Copy to .env and fill in. The API refuses to start in production while any
# integration below is still "mock", so a half-configured deployment fails at
# boot rather than quietly accepting payments nobody ever made.

NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/psirs
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=15000

# --- Secrets (minimum 32 characters each; required in production) -----------
JWT_SECRET=
# Key for HMAC-hashing national identity numbers. Rotating it breaks identity
# matching for existing records, so treat it as long-lived and back it up
# separately from the database.
IDENTITY_HASH_SECRET=
PAYMENT_WEBHOOK_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# How long a session may live in total, however often it is refreshed. The
# agent PWA persists its refresh token so field agents stay signed in across app
# restarts with no connectivity; this is what stops that token becoming a
# permanent credential on a lost handset. 30 days.
SESSION_ABSOLUTE_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
STEP_UP_TTL_SECONDS=600
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12

# --- Payment gateway --------------------------------------------------------
# Payment gateway: "remita" in every real environment, "mock" for development.
# config.ts refuses to boot in production while this is "mock", and refuses to
# boot as "remita" without the credentials below.
PAYMENT_GATEWAY=mock
# Where the gateway returns the taxpayer's browser after they pay. In production
# this must be a real HTTPS address: config.ts refuses to boot on a localhost or
# plain-HTTP value, because the alternative is dropping a citizen on a dead page
# at the moment just after they part with money.
PAYMENT_CALLBACK_URL=http://localhost:5173/payment/return

# --- Remita ---------------------------------------------------------------
# Issued to PSIRS. REMITA_SERVICE_TYPE_ID is per revenue stream.
REMITA_BASE_URL=https://remitademo.net
REMITA_MERCHANT_ID=
REMITA_API_KEY=
REMITA_SERVICE_TYPE_ID=

# Only codes listed here can mark money as received. Confirm the full code set
# against the PSIRS Remita sandbox before go-live.
REMITA_SUCCESS_STATUS_CODES=00
# Left empty on purpose: a code in neither list stays PENDING, so a
# mis-specified list can never wrongly close a transaction that was paid.
REMITA_FAILURE_STATUS_CODES=

# Optional hardening for the notification endpoint. Remita does not sign
# callbacks; neither control is required, because a notification only prompts a
# status query and cannot itself confirm a payment.
REMITA_NOTIFICATION_SECRET=
REMITA_NOTIFICATION_IP_ALLOWLIST=
REMITA_TIMEOUT_MS=20000

# Optional bulk transaction report, relative to REMITA_BASE_URL. Left unset,
# reconciliation builds the gateway's statement by asking Remita about each RRR
# the platform issued, using the status API already in production use. Setting
# it adds the one thing that route cannot do: noticing a collection against an
# RRR this platform has no record of.
REMITA_STATEMENT_PATH=
REMITA_STATEMENT_CONCURRENCY=4
WEBHOOK_TOLERANCE_SECONDS=300

# --- Authoritative systems (PRD §82) ---------------------------------------
# `mock` selects a development stand-in. The process refuses to start in
# production while any integration below is still `mock`.

# --- PSIRS TIN service (PRD §11) --------------------------------------------
# `{tin}` is substituted into the lookup path.
TIN_SERVICE=mock
TIN_SERVICE_URL=
TIN_SERVICE_API_KEY=
TIN_SERVICE_TIMEOUT_MS=20000
TIN_LOOKUP_PATH=/tins/{tin}
TIN_REGISTER_PATH=/tins

# Where to read each field. Dotted paths work: TIN_NUMBER_PATH=data.tin
TIN_NUMBER_PATH=tin
TIN_NAME_PATH=fullName
TIN_TYPE_PATH=taxpayerType
TIN_STATUS_PATH=status
TIN_REFERENCE_PATH=reference
TIN_MESSAGE_PATH=message

TIN_NOT_FOUND_VALUES=not_found,notfound,no_record,none
TIN_ASSIGNED_VALUES=assigned,issued,success,successful,completed
TIN_PENDING_VALUES=pending,processing,accepted,queued,in_progress

# Empty by default: an unmapped status leaves the registration in flight to be
# chased, rather than declaring an applicant refused. Only list values that
# genuinely mean "the service considered this applicant and declined".
TIN_REJECTED_VALUES=

# Optional. Set it and a reply carrying a malformed number is treated as still
# pending rather than written to taxpayers.tin — a UNIQUE column on a row that
# cannot be deleted, where a junk value is permanent and blocks the real number.
#   TIN_FORMAT_PATTERN=^\d{8,12}$
TIN_FORMAT_PATTERN=

# --- Bank account verification (Addendum §16) -------------------------------
# Commission accounts only; government revenue never passes through an agent's
# account. `{accountNumber}` and `{bankCode}` are substituted into the path, so
# a query-style and a path-style endpoint are both configuration.
#
# Whether the resolved name is the agent's is decided by matchesAccountName in
# integrations/banks/types.ts — one tested rule, not one per vendor.
BANK_VERIFICATION=mock
BANK_VERIFICATION_URL=
BANK_VERIFICATION_API_KEY=
BANK_VERIFICATION_TIMEOUT_MS=20000
BANK_RESOLVE_PATH=/resolve?account_number={accountNumber}&bank_code={bankCode}
BANK_ACCOUNT_NAME_PATH=account_name
BANK_REFERENCE_PATH=reference
BANK_STATUS_PATH=status
BANK_NOT_FOUND_VALUES=not_found,notfound,invalid_account,no_record

# --- Identity verification (Addendum §4-§7) ---------------------------------
# Any value other than `mock` selects the HTTP adapter and becomes the provider
# name recorded against each clearance. The adapter POSTs the applicant and
# reads the response through the paths below, so a vendor whose response shape
# differs is a configuration change rather than a code change.
KYC_PROVIDER=mock
KYC_PROVIDER_URL=
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_TIMEOUT_MS=20000

# Where to read each field. Dotted paths work: KYC_STATUS_PATH=data.status
KYC_STATUS_PATH=status
KYC_REFERENCE_PATH=reference
KYC_LIVENESS_PATH=liveness
KYC_REASON_PATH=reason

# Vendors disagree about vocabulary, so the mapping is configuration. Anything
# in none of these lists becomes UNDER_REVIEW — a human decides. No value here
# can make an unrecognised status clear an applicant.
KYC_CLEARED_VALUES=verified,cleared,success,successful,match,found,true
KYC_FAILED_VALUES=failed,rejected,no_match,not_found,mismatch,false
KYC_MORE_INFO_VALUES=incomplete,more_info,more_information_required,additional_information_required,pending_documents

# --- Vehicle registration authority (PRD §21, §22) --------------------------
# `{registration}` is replaced with the URL-encoded registration number, so a
# path-parameter registry and a query-parameter one are both configuration:
#   VEHICLE_REGISTRY_LOOKUP_PATH=/search?plate={registration}
VEHICLE_REGISTRY=mock
VEHICLE_REGISTRY_URL=
VEHICLE_REGISTRY_API_KEY=
VEHICLE_REGISTRY_TIMEOUT_MS=20000
VEHICLE_REGISTRY_LOOKUP_PATH=/vehicles/{registration}
VEHICLE_REGISTRY_RENEWAL_PATH=/vehicles/{registration}/renewals

# Where the vehicle object sits in the response; empty means the root.
VEHICLE_REGISTRY_RECORD_PATH=
VEHICLE_REGISTRY_STATUS_PATH=status

# Deliberately short. Only an explicit "no such vehicle" — a 404, or one of
# these status values — means a vehicle is unregistered. Every other unreadable
# answer is treated as "we could not ask", because recording a registered
# vehicle as unregistered is the more expensive mistake.
VEHICLE_REGISTRY_NOT_FOUND_VALUES=not_found,notfound,no_record,none,unregistered

# --- Notifications ----------------------------------------------------------
# A citizen holds no account on this platform, so the SMS carrying their receipt
# number and verification code is the only copy of their proof of payment they
# ever receive. The process refuses to start in production while either provider
# is still "mock".
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
SMS_SENDER_ID=PSIRS
FROM_EMAIL=no-reply@psirs.pl.gov.ng

SMS_PROVIDER_URL=
# Leave empty to send email through the same endpoint as SMS.
EMAIL_PROVIDER_URL=
MESSAGE_PROVIDER_API_KEY=
MESSAGE_PROVIDER_TIMEOUT_MS=15000

# The Nigerian gateways (Termii, Africa's Talking, Infobip, Twilio) disagree
# about exactly these fields and nothing else.
MESSAGE_RECIPIENT_FIELD=to
MESSAGE_SENDER_FIELD=from
MESSAGE_BODY_FIELD=message
MESSAGE_REFERENCE_PATH=message_id
MESSAGE_ERROR_PATH=message

# --- Document storage -------------------------------------------------------
# "s3" for any S3-compatible store; "local" is development only and the process
# refuses to start with it in production — a container's disk loses every
# receipt it holds on the next deploy, while the document records still point
# at them.
STORAGE_DRIVER=local
STORAGE_PATH=./storage
SIGNED_URL_TTL_SECONDS=900

# S3-compatible object storage. Works with AWS S3, MinIO, Backblaze B2 and
# DigitalOcean Spaces. STORAGE_ENDPOINT carries the scheme and host.
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Path-style by default, because self-hosted stores generally do not offer
# virtual-hosted addressing. Set false on AWS if you prefer.
STORAGE_FORCE_PATH_STYLE=true
STORAGE_TIMEOUT_MS=30000

# --- Commission (PRD §25: 1.5% = 150 basis points) --------------------------
DEFAULT_COMMISSION_BASIS_POINTS=150
COMMISSION_HOLD_HOURS=72

# --- Security ---------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
# Agent applications per hour, per source address. Tight on purpose: an
# application consumes government review time.
AGENT_APPLY_RATE_LIMIT_MAX=5
# Browser origins allowed to call the API — the agent PWA and the portal. Every
# entry must be a real HTTPS origin in production; config.ts refuses localhost,
# plain HTTP and an empty list at boot.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false

# --- PWA version enforcement (Addendum §43) --------------------------------
MIN_AGENT_VERSION=1.0.0
RECOMMENDED_AGENT_VERSION=1.0.0

# The portal address printed and QR-encoded onto every receipt and renewal
# certificate, and the base of every referee invitation link.
#
# Set this before go-live. Receipts are immutable by design, so a wrong value is
# not correctable after the fact: every receipt issued carries a QR code no
# citizen can follow, and no referee can answer an invitation, which halts agent
# clearance. config.ts refuses to boot in production on a localhost or
# plain-HTTP value for exactly that reason.
VERIFICATION_BASE_URL=http://localhost:5174/verify

# --- Observability (blocker B-3) --------------------------------------------
# An unwatched revenue platform is the failure this codebase is built to avoid:
# it records what it still owes in half a dozen queues, and that is worth
# nothing if nobody is told when one stops draining. Production refuses to boot
# with ERROR_REPORTING still "mock" or METRICS_TOKEN unset.
#
# Any service that accepts a JSON POST works — Sentry, GlitchTip, Rollbar, or a
# webhook into an operations channel. No vendor SDK is used: an SDK here would
# run inside the failure path it exists to report.
ERROR_REPORTING=mock
ERROR_REPORTING_URL=
ERROR_REPORTING_API_KEY=
ERROR_REPORTING_TIMEOUT_MS=5000

# Bearer token required to scrape /metrics. The endpoint exposes queue depths
# and confirmation counts — operational shape rather than taxpayer data, but
# not something to publish.
METRICS_TOKEN=

# debug | info | warn | error. Defaults to info in production, debug elsewhere.
# Production emits one JSON object per line; development prints readable text.
LOG_LEVEL=

# --- Deployment (docs/DEPLOYMENT.md) ----------------------------------------
# Whether the API applies pending migrations as it starts. Convenient for a
# single node, wrong for a real deployment where the pipeline runs migrations
# once as its own step before any new container is admitted. Set false there.
RUN_MIGRATIONS_ON_BOOT=true

# --- Backups (docs/DISASTER-RECOVERY.md) ------------------------------------
# Read by apps/api/scripts/backup.sh, not by the application.
BACKUP_DIR=./backups
BACKUP_RETAIN_DAYS=7
# "s3" to push offsite. Without it the script says plainly that a local-only
# dump is not a backup.
BACKUP_UPLOAD=
BACKUP_S3_URI=

# --- Web push (optional) ------------------------------------------------------
# Both blank: push is off and the key endpoint says so. One set without the
# other: the server refuses to start in production, because that deployment
# would send nothing while looking configured.
#
# Generate once and keep — a browser binds its subscription to the public key
# permanently, so changing it unsubscribes every handset with no warning:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:revenue@psirs.pl.gov.ng
# Outbound proxy for pushes; falls back to HTTPS_PROXY when unset.
PUSH_PROXY_URL=
