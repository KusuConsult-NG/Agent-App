# ==============================================================================
# Plateau State Revenue Platform — Production Environment Configuration
# ==============================================================================

NODE_ENV=production
PORT=4000

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgres://postgres:SECURE_POSTGRES_PASSWORD_HERE@postgres:5432/psirs
DB_POOL_SIZE=25
DB_STATEMENT_TIMEOUT_MS=15000

# --- Cryptographic Secrets (Minimum 32 characters each) -----------------------
JWT_SECRET=GENERATE_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS_A1B2C3D4E5F6
IDENTITY_HASH_SECRET=GENERATE_LONG_LIVED_HMAC_SECRET_FOR_NIN_HASHING_123456789
PAYMENT_WEBHOOK_SECRET=REMITA_OR_GATEWAY_WEBHOOK_HMAC_SECRET_SIGNING_KEY_32CHARS

# --- Sessions & Time-To-Live (Seconds) ----------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
SESSION_ABSOLUTE_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
STEP_UP_TTL_SECONDS=600

# --- Live Payment Gateway (Remita Production) ---------------------------------
PAYMENT_GATEWAY=remita
PAYMENT_CALLBACK_URL=https://agent.revenue.plateau.gov.ng/payment/return
REMITA_BASE_URL=https://login.remita.net
REMITA_MERCHANT_ID=PSIRS_MERCHANT_ID_HERE
REMITA_API_KEY=PSIRS_REMITA_API_KEY_HERE
REMITA_SERVICE_TYPE_ID=PSIRS_SERVICE_TYPE_ID_HERE
REMITA_SUCCESS_STATUS_CODES=00
REMITA_TIMEOUT_MS=20000

# --- Authoritative External Integrations --------------------------------------
# 1. PSIRS / Joint Tax Board TIN Lookup & Registration API
TIN_SERVICE=http
TIN_SERVICE_URL=https://tin.psirs.pl.gov.ng/api/v1
TIN_SERVICE_API_KEY=PSIRS_TIN_API_TOKEN_HERE

# 2. Bank Name Enquiry & Account Verification (NIBSS / Payment Switch)
BANK_VERIFICATION=http
BANK_VERIFICATION_URL=https://api.nibss-plc.com.ng/v1/name-enquiry
BANK_VERIFICATION_API_KEY=NIBSS_API_KEY_HERE

# 3. Identity Verification / KYC (NIMC / BVN Provider)
KYC_PROVIDER=http
KYC_PROVIDER_URL=https://api.verified.africa/smarteid/v1
KYC_PROVIDER_API_KEY=IDENTITY_PROVIDER_API_KEY_HERE

# 4. Vehicle Registration Authority (Plateau State Licensing / FRSC)
VEHICLE_REGISTRY=http
VEHICLE_REGISTRY_URL=https://mv.plateau.gov.ng/api/v1
VEHICLE_REGISTRY_API_KEY=VEHICLE_AUTHORITY_API_KEY_HERE

# 5. Transactional SMS & Email Dispatch
SMS_PROVIDER=http
SMS_PROVIDER_URL=https://api.termii.com/api/sms/send
MESSAGE_PROVIDER_API_KEY=TERMII_SMS_API_KEY_HERE
SMS_SENDER_ID=PSIRS
FROM_EMAIL=receipts@revenue.plateau.gov.ng

# --- Secure S3 Object Storage for Receipts & Evidence -------------------------
STORAGE_DRIVER=s3
STORAGE_BUCKET=psirs-receipts-production
STORAGE_ENDPOINT=https://s3.af-south-1.amazonaws.com
STORAGE_REGION=af-south-1
STORAGE_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID_HERE
STORAGE_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY_HERE
STORAGE_FORCE_PATH_STYLE=false

# --- Telemetry & APM ----------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true

# --- Web Push VAPID Keys -----------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
