{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "declaration": true
  },
  "include": ["src/**/*"],
  // The whole test directory, not just `*.test.ts`. `helpers.ts` was being
  // compiled into `dist` and shipped in the production image, and it exports a
  // `resetDatabase()` that TRUNCATEs every financial table. Nothing reachable
  // from the entrypoint imports it, so this is dead weight rather than a live
  // hazard — but dead weight that truncates the receipts table does not belong
  // in a government revenue image.
  "exclude": ["src/tests/**"],
  "references": [{ "path": "../../packages/shared" }]
}
