# ==============================================================================
# PSIRS front end — identical to Dockerfile.agent, under the other name
# ==============================================================================
#
# THIS FILE AND `Dockerfile.agent` SERVE EXACTLY THE SAME THING.
#
#     /          the agent PWA
#     /portal/   the officer portal, and with it /verify, /referee,
#                /group-attestation and /citizen
#     /api/      proxied to the API service
#
# WHY TWO NAMES FOR ONE IMAGE
#
# A service's Dockerfile Path is a setting in a dashboard, and this deployment
# was pointed at `Dockerfile.portal` while everybody involved believed it was
# on `Dockerfile.agent`. What that produced was the portal served at `/`, so a
# field agent signing in at the root reached the officer portal and was shown
# a screen explaining that their tools were in the agent app — which was true,
# and the agent app was nowhere on that hostname. The setting was corrected
# twice and the behaviour did not change, which is as much evidence as anyone
# needs that the failure mode is the setting itself.
#
# It used to build the portal alone and serve it at `/`. Nothing depended on
# that: the deployment has one front-end service, and no separate portal
# service has ever existed. So the difference between the two files bought
# nothing and cost a day.
#
# Making them identical means a service pointed at either name gets a correct
# deployment. If a portal-only image is ever genuinely wanted, give it its own
# name and its own reason, rather than restoring a difference that exists only
# to be got wrong.
#
# Keep this file in step with `Dockerfile.agent`. It is derived from it, and
# `a-front-end-that-cannot-reach-its-api.test.ts` holds both to the same
# checks.
# ==============================================================================

# Stage 1: build both front ends
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/shared/tsconfig.json packages/shared/tsconfig.esm.json ./packages/shared/
COPY apps/agent/package.json apps/agent/tsconfig.json ./apps/agent/
COPY apps/portal/package.json apps/portal/tsconfig.json ./apps/portal/

RUN npm ci --ignore-scripts

COPY packages/shared ./packages/shared
COPY apps/agent ./apps/agent
COPY apps/portal ./apps/portal

RUN npm run build --workspace @psirs/shared
# ---------------------------------------------------------------------------
# The one build-time setting either client has, and the reason it is declared.
#
# apps/agent/src/lib/verification-url.ts reads
# `import.meta.env.VITE_VERIFICATION_BASE_URL`: the public address printed and
# QR-encoded onto a thermal paper receipt. Vite picks prefixed names out of the
# build environment and bakes the value into the bundle.
#
# In a Docker build a name reaches `RUN` only if the stage declares it. Without
# this line the variable is unreachable in the only front-end image this
# repository ships — `--build-arg` is dropped with a warning, a platform's
# service variable never arrives, and the bundle is built with the value
# absent. packages/shared/src/escpos.ts emits the QR block only when a URL is
# supplied, so every receipt then prints with no QR code and no link at all,
# while nothing fails and no log says so.
#
# Absent stays a legitimate value — the note at the top of verification-url.ts
# explains why a missing link beats a wrong one — so there is no default and
# no startup check. What this declaration changes is only that an operator who
# sets it gets it.
#
# It is NOT the API's `VERIFICATION_BASE_URL`. That one is read at runtime by
# apps/api/src/lib/public-urls.ts and governs the QR on PDF certificates and
# the referee, attestation and citizen links. The two cover different paper
# and both have to be set; on a single-origin deployment both carry the
# `/portal` subpath.
# ---------------------------------------------------------------------------
ARG VITE_VERIFICATION_BASE_URL
RUN npm run build --workspace @psirs/agent

# ---------------------------------------------------------------------------
# The portal is built for the subpath it will be served from.
#
# Vite writes absolute URLs into index.html — `/assets/index-<hash>.js`,
# `/icon.svg` — and served under /portal/ every one of them is a 404 at the
# root, answered by the agent's SPA fallback with the agent's index.html. The
# page loads, blank, with a console full of MIME-type errors and nothing that
# names the cause.
#
# `--base=/portal/` on the command line rather than `base` in
# vite.config.ts, so the same source still builds for `/` under `npm run dev`,
# where the portal is served on its own port. Verified: the emitted index.html
# names /portal/assets/... and /portal/icon.svg.
#
# This rewrites build-time asset URLs only. `API_BASE = '/api/v1'` in
# apps/portal/src/lib/api.ts is a runtime string and is untouched, which is
# right — the API is at /api/v1, not /portal/api/v1.
# ---------------------------------------------------------------------------
# Verified that npm forwards the flag to the end of the script — the build is
# `tsc -b && vite build`, so `--` args land on `vite build` and not on `tsc`.
RUN npm run build --workspace @psirs/portal -- --base=/portal/

# Stage 2: nginx
FROM nginx:1.27-alpine AS runner

# Rendered as `default.conf`, overwriting the stock file at that path. See the
# long note in Dockerfile.agent for what happened when this was named
# `<app>.conf` and left the stock config in place: two server blocks on one
# port, nginx logging `conflicting server name`, and the `/api/` proxy this
# image exists to provide never in effect.
RUN rm -rf /etc/nginx/conf.d/default.conf

# ---------------------------------------------------------------------------
# The security headers, written once because nginx will not merge them.
#
# `add_header` does not accumulate across scopes. A location declaring any
# `add_header` of its own REPLACES the inherited set instead of adding to it,
# so these four written once at server scope were served on `/`, `/index.html`
# and `/portal/` and on nothing else: every location that sets a
# `Cache-Control` — /sw.js, both /assets/ prefixes, the manifest and the icon
# regex — answered with none of them.
#
# The documents keeping them is why it went unnoticed. Clickjacking and
# referrer leakage are document concerns, and the documents were covered. What
# was lost is `nosniff` on every static asset, which is the one of the four
# that means something on a script, a stylesheet or an SVG.
#
# One file included at every scope that needs it, rather than four lines
# repeated six times, so the set cannot drift between locations. It carries no
# `${...}` names and is therefore not a template — `NGINX_ENVSUBST_FILTER`
# does not reach it and does not need to.
# ---------------------------------------------------------------------------
COPY <<'EOF' /etc/nginx/snippets/psirs-security-headers.conf
add_header X-Frame-Options "DENY" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "geolocation=(self), camera=(self), microphone=()" always;
EOF

COPY <<'EOF' /etc/nginx/templates/default.conf.template
server {
    listen ${PORT} default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/psirs-security-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # The agent's service worker, never cached. It is also the file that
    # decides what an agent may be shown offline, so a stale copy is a
    # correctness problem and not just a slow update.
    location = /sw.js {
        include /etc/nginx/snippets/psirs-security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }

    # --------------------------------------------------------------------
    # The API shares this origin.
    #
    # Both clients call a relative `/api/v1`, so the refresh cookie, the
    # CSP `connect-src 'self'` and the absence of any preflight all rest on
    # it. `^~` so this beats the static-file regex below rather than
    # racing it.
    #
    # RESOLVED PER REQUEST, NOT ONCE AT STARTUP.
    #
    # `proxy_pass http://${API_ORIGIN};` with a literal hostname is resolved
    # by nginx when it loads this file, and the result is then held for the
    # life of the process. On a platform where the API is a separate service
    # on a private network, that address changes every time the API is
    # redeployed — and the front end goes on dialling the container that has
    # gone. What the person sees is a front end that worked, then stopped,
    # with no deploy of its own to blame: every /api/v1 call fails at the
    # network and sign-in reports "The request failed."
    #
    # It is also brittle the other way. A name that does not resolve at load
    # is a fatal configuration error, so a front end that starts before its
    # API exists does not start at all.
    #
    # Putting the upstream in a variable defers resolution to each request,
    # and `resolver` says which DNS server to ask. The resolver line is
    # generated at container start from /etc/resolv.conf by
    # 15-nginx-resolver.envsh, because the address differs between Docker's
    # embedded DNS and a platform's own, and hardcoding 127.0.0.11 would
    # work in one and silently fail in the other.
    #
    # `$request_uri` IS REQUIRED HERE. With a variable in proxy_pass nginx
    # stops appending the request URI by itself, and without it every call
    # would arrive at the API as `/` — the API would answer 404 for
    # everything and the cause would look nothing like the symptom.
    # `$request_uri` carries the path AND the query string, so a filtered
    # list keeps its filters.
    # --------------------------------------------------------------------
    location ^~ /api/ {
        # A KYC document is a photograph of an ID card and the API accepts
        # up to 8 MB (`MAX_DOCUMENT_BYTES`). nginx defaults to 1 MB and
        # refuses the upload with its own 413 before the API sees it —
        # measured at 2 MB. Set above the API's limit so an oversized
        # document is refused by the API, in the sentence it wrote for the
        # person holding the phone, not by a proxy error page.
        client_max_body_size 12m;

        resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
        set $api_origin ${API_ORIGIN};
        proxy_pass http://$api_origin$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 120s;
    }

    # --------------------------------------------------------------------
    # The portal's hashed assets. `^~` again, and before /portal/ so the
    # immutable caching applies rather than being inherited from the SPA
    # block below.
    # --------------------------------------------------------------------
    location ^~ /portal/assets/ {
        include /etc/nginx/snippets/psirs-security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # --------------------------------------------------------------------
    # The officer portal, and with it /verify, /referee,
    # /group-attestation and /citizen.
    #
    # It is a hash router by deliberate choice (apps/portal/src/router.tsx:
    # "so a static host serves every route from one file with no rewrite
    # rules to get wrong"), which is what makes a subpath mount this
    # cheap: the part after `#` never reaches nginx, so
    # `/portal/#/verify/ABC` is one request for `/portal/` and there are
    # no per-route rules to write.
    #
    # The fallback names /portal/index.html rather than /index.html. With
    # the root fallback an unknown path under /portal/ would be answered
    # with the AGENT's shell — 200, correct content type, entirely the
    # wrong application.
    #
    # A request for bare `/portal` is not matched by this prefix. It falls
    # to `location /`, whose `try_files $uri/` finds the directory and
    # redirects to `/portal/`. Verified against real nginx: 301.
    # --------------------------------------------------------------------
    location /portal/ {
        try_files $uri $uri/ /portal/index.html;
    }

    # The agent's hashed assets.
    location ^~ /assets/ {
        include /etc/nginx/snippets/psirs-security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ------------------------------------------------------------------
    # The manifest's own media type, set for THIS ONE PATH.
    #
    # `.webmanifest` is absent from nginx's bundled mime.types, so it is
    # served as application/octet-stream from `default_type`. Chromium
    # accepts that anyway — asked through the DevTools protocol it reported
    # no manifest errors and every install criterion met — so this is
    # hygiene, not a fix for anything observed.
    #
    # IT MUST NOT BE WRITTEN AS AN nginx `types` BLOCK HERE. Such a block
    # does not extend the map inherited from the http-level
    # `include /etc/nginx/mime.types`; it REPLACES it. Written that way, the
    # only extension nginx recognised in this whole server was
    # `.webmanifest`, and every other file — index.html, the JS bundle, the
    # SVG crest — came back as application/octet-stream. With the `nosniff`
    # header above, a browser takes that literally and DOWNLOADS the page
    # instead of rendering it. Measured against real nginx:
    #
    #     /                 200 application/octet-stream
    #     /assets/index.js  200 application/octet-stream
    #     /icon.svg         200 application/octet-stream
    #
    # and Chromium answered a navigation to it with "Download is starting".
    # Both applications were completely dead, for the sake of a media type
    # that nothing had complained about.
    #
    # `default_type` in an exact-match location applies only where the type
    # cannot be derived from the extension, which for `.webmanifest` is
    # always, and reaches nothing else.
    # ------------------------------------------------------------------
    location = /manifest.webmanifest {
        include /etc/nginx/snippets/psirs-security-headers.conf;
        default_type application/manifest+json;
        expires 7d;
        add_header Cache-Control "public";
    }

    # Icons and manifests for either app. A regex location, so it is tried
    # before the prefix blocks that lack `^~` — which is why /portal/ sits
    # above without it: a real file under /portal/ served straight from
    # disk is the right answer, and a missing one should 404 rather than
    # fall back to an HTML shell.
    location ~* \.(?:manifest|webmanifest|svg|png|ico)$ {
        include /etc/nginx/snippets/psirs-security-headers.conf;
        expires 7d;
        add_header Cache-Control "public";
    }

    # The agent, and its SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
EOF

# envsubst is limited to these two names. Without the filter it would also
# eat `$uri`, `$host`, `$remote_addr` and `$proxy_add_x_forwarded_for` —
# every nginx variable here is `$name`-shaped and envsubst cannot tell them
# from its own.
ENV NGINX_ENVSUBST_FILTER=(API_ORIGIN|PORT|NGINX_RESOLVER)

# The port the platform routes to, not the one this image prefers. Railway
# injects PORT and expects the process to honour it; an image listening
# elsewhere is reached by nothing and the edge answers "Application failed to
# respond" — a deployment that succeeded and a service nobody can talk to.
#
# `.envsh`, not `.sh`: the nginx entrypoint SOURCES .envsh and EXECUTES .sh
# in a subshell, so an export from a .sh would not survive to
# 20-envsubst-on-templates.sh, which is the entire point.
# The DNS server this container actually has.
#
# Written into the config as `resolver`, which the /api/ proxy needs because
# its upstream is a variable and so is resolved per request rather than once
# at load. The address is read from /etc/resolv.conf rather than hardcoded:
# Docker's embedded DNS is 127.0.0.11, a platform's own is something else, and
# a wrong resolver fails at request time with "no resolver defined" or a
# timeout — neither of which names DNS as the problem.
#
# `.envsh`, so the export survives to 20-envsubst-on-templates.sh.
# Falls back to Docker's embedded DNS, then to a public resolver, because an
# empty value makes nginx refuse to load the file at all.
COPY <<'SH' /docker-entrypoint.d/15-nginx-resolver.envsh
# shellcheck shell=sh
#
# The DNS servers this container actually has, in a form nginx will accept.
#
# AN IPv6 NAMESERVER MUST BE BRACKETED. A private container network is often
# IPv6, and `resolver fd12:3456:789a::1` is not a syntax error nginx tolerates:
#
#     [emerg] invalid port in resolver "fd12:3456:789a::1"
#
# nginx then refuses to load the file and the container never starts, which the
# platform reports as "Deployment failed" with nothing naming DNS. Measured —
# this is what took the front end down once already. `[fd12:3456:789a::1]`
# parses. An IPv4 address must NOT be bracketed, so each one is tested for a
# colon rather than all of them wrapped.
NGINX_RESOLVER=""
while read -r _key _value _rest; do
  [ "${_key}" = "nameserver" ] || continue
  case "${_value}" in
    *:*) NGINX_RESOLVER="${NGINX_RESOLVER}[${_value}] " ;;
    *)   NGINX_RESOLVER="${NGINX_RESOLVER}${_value} " ;;
  esac
done < /etc/resolv.conf

# An empty value is `resolver ;`, which is also fatal at load. Docker's
# embedded DNS is the best guess available; if it is wrong the failure is a
# request-time timeout, which leaves the service up and says so in the log —
# strictly better than a container that will not start.
if [ -z "${NGINX_RESOLVER}" ]; then
  NGINX_RESOLVER="127.0.0.11"
  echo "15-nginx-resolver.envsh: /etc/resolv.conf named no nameserver; falling back to ${NGINX_RESOLVER}" >&2
fi

export NGINX_RESOLVER
echo "15-nginx-resolver.envsh: resolving the API through ${NGINX_RESOLVER}"
SH
RUN chmod +x /docker-entrypoint.d/15-nginx-resolver.envsh

COPY <<'SH' /docker-entrypoint.d/10-default-port.envsh
# shellcheck shell=sh
export PORT="${PORT:-80}"
SH
RUN chmod +x /docker-entrypoint.d/10-default-port.envsh

# Which front-end image this is.
#
# Both front-end images render `default.conf.template`, so the envsubst line
# in the startup log no longer names one — it used to say
# `agent.conf.template`. That mattered: a log showing the portal's template
# while serving the agent service's hostname is how a service pointed at the
# wrong image came to light. `agent+portal` distinguishes this file from
# `Dockerfile.portal`, which is the portal alone.
ENV PSIRS_APP=from-Dockerfile.portal

# Refuse to start rather than serve a front end that cannot reach its API.
# An empty API_ORIGIN substitutes to `proxy_pass http://;`, which nginx
# rejects with a parse error naming a line rather than a cause; and any
# default would be a wrong host serving a shell where nothing works. Runs
# before 20-envsubst-on-templates.sh.
COPY <<'SH' /docker-entrypoint.d/05-require-api-origin.sh
#!/bin/sh
set -e
echo "05-require-api-origin.sh: this image was built ${PSIRS_APP:-from an unknown Dockerfile}"
echo "05-require-api-origin.sh: agent at /, officer portal and public verification at /portal/"
if [ -z "${API_ORIGIN:-}" ]; then
  echo "FATAL: API_ORIGIN is not set." >&2
  echo "  This image serves /api/ by proxying to the API service, because both" >&2
  echo "  clients call a relative /api/v1 and need to share an origin with it." >&2
  echo "  Set API_ORIGIN to the API's host:port on the private network," >&2
  echo "  for example: API_ORIGIN=agent-app.railway.internal:4000" >&2
  exit 1
fi
echo "05-require-api-origin.sh: proxying /api to ${API_ORIGIN}"
SH
RUN chmod +x /docker-entrypoint.d/05-require-api-origin.sh

# Agent at the root, portal beneath it. Order matters only in that the portal
# copy must not be overwritten by the agent's; they occupy disjoint paths.
COPY --from=builder /app/apps/agent/dist /usr/share/nginx/html
COPY --from=builder /app/apps/portal/dist /usr/share/nginx/html/portal

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider "http://localhost:${PORT:-80}/" || exit 1

CMD ["nginx", "-g", "daemon off;"]
