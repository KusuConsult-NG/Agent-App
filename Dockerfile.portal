# ==============================================================================
# PSIRS Government & Verification Portal — Production Multi-Stage Dockerfile
# ==============================================================================

# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

# The root of the workspace carries no tsconfig.json — every workspace holds
# its own and none of them extend upwards. Copying one here aborted the build
# on its first instruction, which is why this image had never been built.
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/shared/tsconfig.json packages/shared/tsconfig.esm.json ./packages/shared/
COPY apps/portal/package.json apps/portal/tsconfig.json ./apps/portal/

RUN npm ci --ignore-scripts

COPY packages/shared ./packages/shared
COPY apps/portal ./apps/portal

RUN npm run build --workspace @psirs/shared
RUN npm run build --workspace @psirs/portal

# Stage 2: Nginx Static Server
FROM nginx:1.27-alpine AS runner

# ---------------------------------------------------------------------------
# THIS CONFIG IS RENDERED AS `default.conf`, WHICH IS THE POINT.
#
# It used to render as `<app>.conf` beside the stock `default.conf`, with this
# `rm` expected to have removed that. On the deployed container it had not
# been — the image's own `10-listen-on-ipv6-by-default.sh` found and edited
# `/etc/nginx/conf.d/default.conf` at startup, which it only does when the
# file is there. Why the `rm` did not take is still unexplained; naming the
# template `default.conf.template` makes it not matter, because envsubst
# writes `default.conf` and overwrites whatever is at that path.
#
# What it cost while it was two files: both server blocks listened on the same
# port with `server_name localhost`, so nginx logged
#
#     conflicting server name "localhost" on 0.0.0.0:80, ignored
#
# and kept the first — the stock one, which has no `/api/` proxy. Every API
# call was answered by a static file lookup:
#
#     open() "/usr/share/nginx/html/api/v1/health" failed (2: No such file
#     or directory) ... "HEAD /api/v1/health HTTP/1.1" 404
#
# So the proxy this image exists to provide was never in effect. Reproduced
# against real nginx, byte for byte, before the rename and after.
#
# `server_name _` rather than `localhost` for the same reason: the Host header
# is the platform's public hostname, so `localhost` matched nothing and only
# worked by being the sole block. `default_server` makes that explicit.
# ---------------------------------------------------------------------------
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy custom Nginx SPA configuration
COPY <<'EOF' /etc/nginx/templates/default.conf.template
server {
    listen ${PORT} default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(self), camera=(self), microphone=()" always;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # Hashed JS and CSS assets - long-lived cache
    # --------------------------------------------------------------------
    # The API shares this origin.
    #
    # `src/lib/api.ts` calls a relative `/api/v1`, and `vite.config.ts`
    # says why beside the dev proxy that makes it work locally: the PWA and
    # the API share an origin in production, so the refresh cookie, the CSP
    # and the absence of any preflight all rest on it. Deployed as its own
    # service, this image is what has to make that true.
    #
    # Without this block `/api/v1/...` fell through to the SPA fallback at
    # the bottom and was answered with index.html — 200, `text/html` — so
    # every call died at `response.json()` and nothing in the app worked,
    # sign-in included. Measured, not inferred: real nginx with this block
    # absent answers `GET /api/v1/ping` `200 text/html` and the body is the
    # shell; with it present, `200 application/json`.
    #
    # No trailing slash on proxy_pass, because the API mounts its own
    # routes at `/api/v1` (`app.use('/api/v1', api)`). The URI passes
    # through unchanged rather than being rewritten.
    #
    # API_ORIGIN is host:port on the platform's private network, and is
    # substituted into this file at container start. There is no default:
    # a front-end that silently cannot reach its API is the failure above,
    # and /docker-entrypoint.d/05-require-api-origin.sh refuses to start
    # rather than serve it again.
    # --------------------------------------------------------------------
    location /api/ {
        # A KYC document is a photograph of an ID card and the API accepts
        # up to 8 MB of one (`MAX_DOCUMENT_BYTES`). nginx defaults to 1 MB
        # and refused a 2 MB upload with its own 413 before the API saw it
        # — measured. Set above the API's own limit, so that an oversized
        # document is refused by the API, in the sentence it wrote for the
        # agent holding the phone, rather than by a proxy error page.
        client_max_body_size 12m;

        proxy_pass http://${API_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A statement or a receipt is rendered on demand and the default
        # 60s is close for a long one.
        proxy_read_timeout 120s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA routing fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
EOF

# ---------------------------------------------------------------------------
# API_ORIGIN is substituted into the template above at container start.
#
# NGINX_ENVSUBST_FILTER limits envsubst to that one name. Without it the
# substitution would also eat `$uri`, `$host`, `$remote_addr` and
# `$proxy_add_x_forwarded_for` — every nginx variable in this file is
# `$name`-shaped and envsubst cannot tell them apart from its own.
# ---------------------------------------------------------------------------
ENV NGINX_ENVSUBST_FILTER=(API_ORIGIN|PORT)

# ---------------------------------------------------------------------------
# The port the platform routes to, not the one this image happens to prefer.
#
# `listen 80` was hardcoded, which works only where the platform is told to
# route to 80. Railway's convention is to inject PORT and expect the process
# to honour it; an image listening elsewhere is reached by nothing, and the
# edge answers "Application failed to respond" — a deployment that succeeded
# and a service that cannot be talked to.
#
# `.envsh`, not `.sh`: the nginx entrypoint SOURCES files ending .envsh and
# EXECUTES files ending .sh in a subshell, so an export from a .sh would not
# survive to 20-envsubst-on-templates.sh, which is the whole point of this.
# ---------------------------------------------------------------------------
COPY <<'SH' /docker-entrypoint.d/10-default-port.envsh
# shellcheck shell=sh
export PORT="${PORT:-80}"
SH
RUN chmod +x /docker-entrypoint.d/10-default-port.envsh


# Refuse to start rather than serve a front-end that cannot reach its API.
# An empty API_ORIGIN substitutes to `proxy_pass http://;`, which nginx
# rejects with a parse error naming a line rather than the cause; and any
# default here would be a wrong host serving a shell where nothing works,
# which is the failure this whole block exists to end. Runs before
# 20-envsubst-on-templates.sh.
COPY <<'SH' /docker-entrypoint.d/05-require-api-origin.sh
#!/bin/sh
set -e
if [ -z "${API_ORIGIN:-}" ]; then
  echo "FATAL: API_ORIGIN is not set." >&2
  echo "  This image serves /api/ by proxying to the API service, because the" >&2
  echo "  client calls a relative /api/v1 and needs to share an origin with it." >&2
  echo "  Set API_ORIGIN to the API's host:port on the private network," >&2
  echo "  for example: API_ORIGIN=agent-app.railway.internal:4000" >&2
  exit 1
fi
SH
RUN chmod +x /docker-entrypoint.d/05-require-api-origin.sh

# Copy static build artefacts
COPY --from=builder /app/apps/portal/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider "http://localhost:${PORT:-80}/" || exit 1

CMD ["nginx", "-g", "daemon off;"]
